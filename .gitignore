# graphify knowledge graph — graph.json and manifest.json ARE committed, so a
# clone or a new ticket worktree starts with the map instead of paying a full
# extraction to rebuild it. manifest.json keys are relative, so the cache still
# matches after a move. Excluded: graph.html (derived view, ~2MB, regenerated
# wholesale), the version-pinned cache, and the local cost tracker.
graphify-out/graph.html
graphify-out/cache/
graphify-out/cost.json
graphify-out/.graphify_*
graphify-out/.chunklist_*
.devexp/health-baseline.json
.devexp/system-health-review.md

# macOS Finder metadata — never useful in a commit, and rsync already
# excludes it from the staged assets (scripts/stage-assets.sh).
.DS_Store
