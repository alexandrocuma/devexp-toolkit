# mcps/.env — values MCP servers need (API keys, install paths)
# Copy this file to mcps/.env and fill in your values.
# This file is gitignored. Never commit mcps/.env.

# ui-inspector ships as its own repo rather than vendored in this one:
#   git clone https://github.com/alexandrocuma/mcp-ui-inspector
#   cd mcp-ui-inspector && ./setup.sh
# Set this to the absolute path of that clone. Until it is set, the
# installer skips ui-inspector with a [REQUIRED] warning and prints the
# setup instructions from mcps/registry.json.
UI_INSPECTOR_DIR=
